# Checkout POS Desktop Environment Template
# Copy this file to `.env.desktop` (kept outside version control) and adjust secrets per install.

# Signals backend to boot in offline/embedded mode (skip cloud-only integrations)
DESKTOP_MODE=true

# Local ports used by the bundled backend + frontend
DESKTOP_BACKEND_PORT=3110
DESKTOP_FRONTEND_PORT=5173

# SQLite database location (Electron installer will create/populate this path)
DATABASE_URL="file:../data/checkout-desktop.db"

# License + activation service endpoints (served by central cloud backend when online)
LICENSE_API_URL="https://checkout-45tb.onrender.com/api/v1/licensing/validate"
LICENSE_DEVICE_REGISTER_URL="https://checkout-45tb.onrender.com/api/v1/licensing/devices/register"

# Encryption secrets for cached license payloads (override per build)
LICENSE_ENCRYPTION_KEY="replace-with-32-char-secret"
LICENSE_TOKEN_SIGNING_KEY="replace-with-32-char-secret"

# Auto-update channel + feed (Electron autoUpdater)
AUTO_UPDATE_CHANNEL=latest
AUTO_UPDATE_FEED_URL="https://updates.checkout-pos.com/windows"

# Grace period + sync cadence (in days)
LICENSE_GRACE_PERIOD_DAYS=14
LICENSE_SYNC_INTERVAL_DAYS=7

# Optional: enable verbose logging for desktop services
DESKTOP_LOG_LEVEL=info
