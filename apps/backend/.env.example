# Environment
NODE_ENV=development

# Server Configuration
PORT=3000
API_PREFIX=api/v1

# CORS Configuration
# Comma-separated list of allowed origins, or '*' for all
# Defaults to: http://localhost:5173,http://localhost:5174,https://checkout-77d99.web.app,https://checkout-77d99.firebaseapp.com
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Firebase Configuration
# For local development, you can use Firebase Emulator or provide service account credentials
# Option 1: Use Firebase Emulator (set FIRESTORE_EMULATOR_HOST)
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# Option 2: Use service account credentials (for connecting to cloud Firestore)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----\n"

# If running in Google Cloud (Cloud Functions, Cloud Run), leave above empty
# and use Application Default Credentials (ADC) instead

# JWT Configuration
JWT_SECRET=change-me-in-production-use-strong-random-secret
JWT_REFRESH_SECRET=change-me-in-production-use-strong-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Payment Configuration
# MockTerminal approval rate (0.0 to 1.0, default: 0.95 = 95% approval)
PAYMENT_MOCK_APPROVE_RATE=0.95

# Cloud Functions Configuration (only used when deployed to Firebase Functions)
# FUNCTION_TARGET=api
# K_SERVICE=api
