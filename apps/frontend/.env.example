# API Configuration
# Backend API URL - defaults to Firebase Cloud Function if not set
# For local development, use: http://localhost:3000
# For production, use your Firebase Cloud Function URL
VITE_API_URL=http://localhost:3000

# Example production URL (replace with your actual Firebase project):
# VITE_API_URL=https://us-central1-your-project-id.cloudfunctions.net/api

# Print Proxy Configuration (optional)
# WebSocket URL for the print proxy server
# Defaults to ws://localhost:8080 if not set
# VITE_PRINT_PROXY_URL=ws://localhost:8080
