# Frontend Environment Variables

# API Configuration
# Set to your backend API URL (optional - defaults to production)
# VITE_API_URL=https://your-backend.onrender.com

# Site URL (used for sitemaps, canonical links, and structured data)
# VITE_SITE_URL=https://checkout.yourdomain.com

# Development Configuration
# Set to 'true' to use local backend via Vite proxy (requires backend running on localhost:3000)
# Set to 'false' or omit to use production backend as fallback
VITE_USE_LOCAL_BACKEND=false

# Download Links (optional)
# VITE_WINDOWS_INSTALLER_URL=https://your-storage.com/installer.exe
# VITE_ANDROID_APK_URL=https://your-storage.com/app.apk
# VITE_MACOS_INSTALLER_URL=https://your-storage.com/installer.dmg
# VITE_IOS_APP_URL=https://apps.apple.com/app/your-app