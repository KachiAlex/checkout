{
  "name": "@pos-checkout/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Checkout POS Desktop Application",
  "author": "Checkout Team",
  "main": "dist/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "cross-env NODE_ENV=development ts-node --transpile-only src/main.ts",
    "build": "tsc -p tsconfig.json",
    "build:frontend": "npm run build --workspace=@pos-checkout/frontend",
    "start": "electron .",
    "prepackage": "npm run build:frontend && npm run build",
    "package": "electron-builder --config electron-builder.yml"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/node-hid": "^1.3.4",
    "cross-env": "^7.0.3",
    "electron": "30.0.0",
    "electron-builder": "^24.9.1",
    "png-to-ico": "^3.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "node-hid": "^2.1.2",
    "prebuild-install": "^7.1.1",
    "usb-detection": "^4.14.2"
  }
}
