{
  "name": "@pos-checkout/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Checkout POS Desktop Application",
  "author": "Checkout Team",
  "main": "dist/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "cross-env NODE_ENV=development ts-node --transpile-only src/main.ts",
    "build": "tsc -p tsconfig.json",
    "build:frontend": "npm run build --workspace=@pos-checkout/frontend",
    "build:icon": "node scripts/convert-icon.js",
    "start": "electron .",
    "prepackage": "npm run build:frontend && npm run build && npm run copy:frontend",
    "prepackage:installer": "npm run build:frontend && npm run build && npm run copy:frontend && npm run build:icon",
    "copy:frontend": "xcopy /E /I /Y ..\\frontend\\dist frontend-dist && node scripts/inject-base-tag.js",
    "package": "electron-packager . \"Checkout POS\" --platform=win32 --arch=x64 --out=release --overwrite --asar --ignore=src --ignore=tsconfig.json --ignore=electron-builder.yml",
    "package:installer": "electron-builder --config electron-builder.yml --win nsis"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/node-hid": "^1.3.4",
    "cross-env": "^7.0.3",
    "electron": "30.0.0",
    "electron-builder": "^24.9.1",
    "electron-packager": "^17.1.2",
    "lodash.get": "^4.4.2",
    "png-to-ico": "^3.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "node-hid": "^2.2.0",
    "prebuild-install": "^7.1.3"
  },
  "optionalDependencies": {
    "usb-detection": "^4.14.2"
  }
}
